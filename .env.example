# Copiá este archivo a .env.local (ignorado por git) y completá los valores.
# Muse Glimmer es open-weight: Meta no lo sirve en su Model API. Opciones:
#   vLLM propio:  GLIMMER_BASE_URL=http://localhost:8000/v1   VITE_GLIMMER_MODEL=muse-glimmer
#   SGLang propio: GLIMMER_BASE_URL=http://localhost:30000/v1
#   Together:     GLIMMER_BASE_URL=https://api.together.xyz/v1        VITE_GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
#   NVIDIA:       GLIMMER_BASE_URL=https://integrate.api.nvidia.com/v1 VITE_GLIMMER_MODEL=meta/muse-glimmer-30b
# Verificá el id del modelo en la página del proveedor antes de usarlo.

# Leídos sólo por el proxy de Vite (servidor). La key nunca llega al navegador.
GLIMMER_BASE_URL=http://localhost:8000/v1
GLIMMER_API_KEY=

# Público: se incluye en el bundle. No pongas secretos con prefijo VITE_.
VITE_GLIMMER_MODEL=muse-glimmer

# Muse Spark (nivel 3) vía Meta Model API: https://api.meta.ai/v1, compatible con OpenAI.
# El proxy de Vite (/api/meta) agrega Authorization: Bearer MODEL_API_KEY del lado del servidor.
MODEL_API_KEY=
# Con la key cargada: npm run replays:record graba respuestas reales para la demo sin key.
# Opcional, sólo para pruebas locales del proxy (por defecto https://api.meta.ai/v1).
# META_BASE_URL=http://localhost:9999/v1
# Público: id del modelo (muse-spark-1.3, 1.2 o 1.1). Por defecto, muse-spark-1.3.
VITE_META_MODEL=muse-spark-1.3
